# =============================================================
# Vishnu Rajeev — Portfolio | Apache config for STRATO hosting
# Static site: uploading these files to the webspace root is enough.
# =============================================================

# Default document
DirectoryIndex index.html

# UTF-8 for text responses
AddDefaultCharset utf-8

# ---- Correct MIME types (usually set by STRATO, kept for safety) ----
<IfModule mod_mime.c>
  AddType image/svg+xml            .svg
  AddType application/pdf          .pdf
  AddType text/css                 .css
  AddType application/javascript   .js
</IfModule>

# ---- Gzip compression ----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE application/xml image/svg+xml
</IfModule>

# ---- Browser caching ----
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                        "access plus 1 week"
  ExpiresByType text/html               "access plus 0 seconds"
  ExpiresByType text/css                "access plus 1 month"
  ExpiresByType application/javascript  "access plus 1 month"
  ExpiresByType image/svg+xml           "access plus 1 month"
  ExpiresByType application/pdf         "access plus 1 month"
</IfModule>

# ---- Security headers ----
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ---- Optional: force HTTPS (enable after your SSL certificate is active) ----
